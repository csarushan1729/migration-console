# Optional: enables model-assisted mapping for leftover/ambiguous columns.
# The demo is fully usable without it (heuristic mapper covers the sample files).
XAI_API_KEY=

# Optional: where job state is persisted (SQLite, via Node's built-in
# node:sqlite). Defaults to ./data/meridian.db, created on first write.
# On hosts with an ephemeral filesystem (e.g. most PaaS free tiers), point
# this at a mounted persistent volume, or set it to :memory: to opt back
# into ephemeral state.
MERIDIAN_DB_PATH=
